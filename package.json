{
  "name": "skill-cli",
  "version": "1.0.0",
  "description": "CLI tool for managing AI coding assistant skills",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "skill": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write . && prettier --write \"**/*.md\"",
    "format:check": "biome format . && prettier --check \"**/*.md\"",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0"
  },
  "lint-staged": {
    "*.{ts,js,json}": ["biome check --write"],
    "*.md": ["prettier --write"]
  },
  "keywords": ["cli", "ai", "skills", "coding-assistant", "bun"],
  "author": "JoobyPM",
  "license": "MIT"
}
